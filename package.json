{
  "name": "sneu",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "db:generate": "turbo run db:generate --filter=@sneu/db",
    "db:migrate": "turbo run db:migrate --filter=@sneu/db",
    "db:push": "turbo run db:push --filter=@sneu/db",
    "db:studio": "turbo run db:studio --filter=@sneu/db",
    "cli": "turbo run cli --filter=@sneu/cli"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.7"
  },
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": "26.10.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.10.0",
      "onFail": "download"
    }
  }
}
